# Local SQLite database (fine for a single-restaurant / self-hosted deployment).
# For a multi-tenant SaaS deployment, point this to a hosted Postgres/libSQL
# database instead and swap the adapter in src/lib/db.ts.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session cookies (JWT). Generate a real one for any
# deployment, e.g.: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"
