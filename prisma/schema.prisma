// Restaurant Manager - database schema
// Multi-tenant ready: every operational record hangs off a Restaurant,
// so this schema can later serve many restaurants (SaaS) from one deployment.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  MANAGER
  CASHIER
  WAITER
  KITCHEN
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  OPEN
  IN_KITCHEN
  READY
  SERVED
  PAID
  CANCELLED
}

enum KitchenStatus {
  QUEUED
  COOKING
  READY
  SERVED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
}

model Restaurant {
  id          String   @id @default(cuid())
  name        String
  logoEmoji   String   @default("🍽️")
  currency    String   @default("IQD")
  taxRate     Float    @default(0)
  address     String?
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users        User[]
  categories   Category[]
  menuItems    MenuItem[]
  modifierGroups ModifierGroup[]
  tables       Table[]
  orders       Order[]
  inventoryItems InventoryItem[]
  shifts       Shift[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(CASHIER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders       Order[]
  shifts       Shift[]
}

model Category {
  id           String   @id @default(cuid())
  nameAr       String
  nameEn       String
  emoji        String   @default("🍴")
  sortOrder    Int      @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems    MenuItem[]
}

model MenuItem {
  id           String   @id @default(cuid())
  nameAr       String
  nameEn       String
  descriptionAr String?
  descriptionEn String?
  price        Float
  cost         Float    @default(0)
  emoji        String   @default("🍽️")
  imageUrl     String?
  available    Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  modifierGroups MenuItemModifierGroup[]
  orderItems     OrderItem[]
}

// A group of options for a menu item, e.g. "Size" or "Extras"
model ModifierGroup {
  id           String   @id @default(cuid())
  nameAr       String
  nameEn       String
  required     Boolean  @default(false)
  multiSelect  Boolean  @default(false)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  modifiers    Modifier[]
  menuItems    MenuItemModifierGroup[]
}

model Modifier {
  id              String   @id @default(cuid())
  nameAr          String
  nameEn          String
  priceDelta      Float    @default(0)

  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  orderItemModifiers OrderItemModifier[]
}

// join table: which modifier groups apply to which menu items
model MenuItemModifierGroup {
  id              String   @id @default(cuid())
  menuItemId      String
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifierGroupId String
  modifierGroup   ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([menuItemId, modifierGroupId])
}

model Table {
  id           String      @id @default(cuid())
  label        String
  zone         String      @default("الصالة الرئيسية")
  seats        Int         @default(4)
  status       TableStatus @default(AVAILABLE)
  posX         Int         @default(0)
  posY         Int         @default(0)

  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  orders       Order[]
}

model Order {
  id           String      @id @default(cuid())
  orderNumber  Int         @default(0)
  type         OrderType   @default(DINE_IN)
  status       OrderStatus @default(OPEN)
  customerName String?
  customerPhone String?
  notes        String?

  subtotal     Float       @default(0)
  discount     Float       @default(0)
  taxAmount    Float       @default(0)
  total        Float       @default(0)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  paidAt       DateTime?

  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  tableId      String?
  table        Table?      @relation(fields: [tableId], references: [id])

  userId       String?
  user         User?       @relation(fields: [userId], references: [id])

  items        OrderItem[]
  payments     Payment[]
}

model OrderItem {
  id            String        @id @default(cuid())
  quantity      Int           @default(1)
  unitPrice     Float
  notes         String?
  kitchenStatus KitchenStatus @default(QUEUED)

  orderId       String
  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItemId    String
  menuItem      MenuItem      @relation(fields: [menuItemId], references: [id])

  modifiers     OrderItemModifier[]
}

model OrderItemModifier {
  id           String   @id @default(cuid())
  priceDelta   Float    @default(0)

  orderItemId  String
  orderItem    OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  modifierId   String
  modifier     Modifier  @relation(fields: [modifierId], references: [id])
}

model Payment {
  id             String        @id @default(cuid())
  method         PaymentMethod
  amount         Float
  tenderedAmount Float?
  changeAmount   Float?
  createdAt      DateTime      @default(now())

  orderId        String
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id             String   @id @default(cuid())
  nameAr         String
  nameEn         String
  unit           String   @default("قطعة")
  unitEn         String   @default("pcs")
  quantity       Float    @default(0)
  lowStockAt     Float    @default(5)
  updatedAt      DateTime @updatedAt

  restaurantId   String
  restaurant     Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
}

// A cashier's work session at the register: opened with a starting cash
// float, closed with a physical count so any over/short is caught the same
// day instead of showing up as a mystery in the books weeks later.
model Shift {
  id            String    @id @default(cuid())
  openingCash   Float
  closingCash   Float?
  expectedCash  Float?
  notes         String?
  openedAt      DateTime  @default(now())
  closedAt      DateTime?

  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  userId        String
  user          User       @relation(fields: [userId], references: [id])
}
